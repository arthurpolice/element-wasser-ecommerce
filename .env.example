# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/element-wasser"

# AWS S3 (product images)
# Required in production; optional in local development until credentials are set.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="eu-central-1"
# Optional: custom CDN/base URL served to clients (e.g. CloudFront)
# S3_PUBLIC_URL_BASE="https://cdn.example.com"
# Optional: S3-compatible endpoint (MinIO, LocalStack, etc.)
# S3_ENDPOINT="http://localhost:9000"
# S3_FORCE_PATH_STYLE="true"

# QStash (deferred backend jobs)
# Required in production; optional in local development until queued jobs are used.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
QSTASH_PUBLISH_BASE_URL="https://element-wasser.example"

# Stripe Checkout
# Required in production; optional in local development until payments are used.
APP_BASE_URL="https://element-wasser.example"
CRON_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

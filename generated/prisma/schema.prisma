// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  owner
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String    @id
  name          String //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  role          UserRole  @default(customer)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]
  customer      Customer?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

enum Salutation {
  HERR
  FRAU
}

enum OrderStatus {
  PLACED
  CANCELLED
  COMPLETED
}

enum OrderPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  DISPATCHED
  FULFILLED
  CANCELLED
}

enum ShippingCarrier {
  SWISS_POST
}

enum PaymentType {
  CHARGE
  REFUND
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentMethod {
  CARD
  TWINT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Customer {
  id         String      @id @default(cuid())
  userId     String?     @unique
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  salutation Salutation?
  firstName  String
  lastName   String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  addresses  Address[]
  orders     Order[]
  reviews    Review[]

  @@index([email])
}

model Address {
  id          String      @id @default(cuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  isMain      Boolean     @default(false)
  salutation  Salutation?
  firstName   String
  lastName    String
  company     String?
  streetLine1 String
  streetLine2 String?
  postalCode  String
  city        String
  countryCode String
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([customerId, isMain])
}

model Manufacturer {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                      String                 @id @default(cuid())
  manufacturerId          String
  manufacturer            Manufacturer           @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  name                    String
  slug                    String                 @unique
  sku                     String                 @unique
  active                  Boolean                @default(false)
  featured                Boolean                @default(false)
  description             Json?
  priceCents              Int
  costCents               Int
  discountPercent         Int?
  stockOnHand             Int                    @default(0)
  stockReserved           Int                    @default(0)
  approvedReviewCount     Int                    @default(0)
  approvedReviewRatingSum Int                    @default(0)
  dispatchMinDays         Int
  dispatchMaxDays         Int
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  images                  ProductImage[]
  categories              ProductCategory[]
  orderLines              OrderLine[]
  reviews                 Review[]
  searchDocument          ProductSearchDocument?
  pendingSearchReindex    ProductSearchReindex?

  @@index([manufacturerId])
  @@index([active])
}

model ProductSearchDocument {
  productId        String                  @id
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  productNameText  String
  manufacturerText String
  skuText          String
  categoryText     String
  descriptionText  String
  searchVector     Unsupported("tsvector")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([searchVector], type: Gin)
}

model ProductSearchReindex {
  productId   String   @id
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  generation  Int      @default(1)
  requestedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestedAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model Category {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  active    Boolean           @default(true)
  sortOrder Int               @default(0)
  parentId  String?
  parent    Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]        @relation("CategoryTree")
  products  ProductCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([parentId])
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, categoryId])
  @@index([categoryId])
}

model OrderNumberSequence {
  year       Int      @id
  nextNumber Int
  updatedAt  DateTime @updatedAt
}

model ProductSkuSequence {
  prefix     String   @id
  nextNumber Int
  updatedAt  DateTime @updatedAt
}

enum OrderOrigin {
  STOREFRONT
  OWNER_DASHBOARD
}

enum EmailNotificationType {
  ORDER_PLACED
  ORDER_PAYMENT_CONFIRMED
  PAYMENT_FAILED
  NEW_PAID_ORDER
  ORDER_CANCELLED
  ORDER_DISPATCHED
}

enum EmailNotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum EmailDeliveryAttemptStatus {
  SENT
  DELIVERED
  FAILED
}

model Order {
  id                            String              @id @default(cuid())
  orderNumber                   String              @unique
  customerId                    String
  customer                      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerSalutation            Salutation?
  customerFirstName             String
  customerLastName              String
  customerEmail                 String
  status                        OrderStatus         @default(PLACED)
  paymentStatus                 OrderPaymentStatus  @default(PENDING)
  fulfillmentStatus             FulfillmentStatus   @default(UNFULFILLED)
  origin                        OrderOrigin         @default(OWNER_DASHBOARD)
  dispatchCarrier               ShippingCarrier?
  trackingNumber                String?
  dispatchedAt                  DateTime?
  paymentExpiresAt              DateTime?
  paymentExpiryStartedAt        DateTime?
  checkoutSubmissionId          String?             @unique
  checkoutSubmissionFingerprint String?
  guestCheckoutFingerprint      String?
  paymentExceptionAt            DateTime?
  paymentExceptionReason        String?
  subtotalCents                 Int
  shippingCents                 Int
  discountCents                 Int                 @default(0)
  totalCents                    Int
  currencyCode                  String              @default("CHF")
  shippingSalutation            Salutation?
  shippingFirstName             String
  shippingLastName              String
  shippingCompany               String?
  shippingStreetLine1           String
  shippingStreetLine2           String?
  shippingPostalCode            String
  shippingCity                  String
  shippingCountryCode           String
  shippingPhone                 String?
  billingSameAsShipping         Boolean             @default(true)
  billingSalutation             Salutation?
  billingFirstName              String
  billingLastName               String
  billingCompany                String?
  billingStreetLine1            String
  billingStreetLine2            String?
  billingPostalCode             String
  billingCity                   String
  billingCountryCode            String
  billingPhone                  String?
  placedAt                      DateTime            @default(now())
  completedAt                   DateTime?
  cancelledAt                   DateTime?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  lines                         OrderLine[]
  payments                      Payment[]
  emailNotifications            EmailNotification[]

  @@index([customerId])
  @@index([customerEmail])
  @@index([guestCheckoutFingerprint, status, paymentStatus, paymentExpiresAt])
  @@index([status, paymentStatus, fulfillmentStatus, paymentExpiresAt])
  @@index([placedAt])
}

model EmailNotification {
  id                  String                  @id @default(cuid())
  orderId             String
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentId           String?
  payment             Payment?                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  deduplicationKey    String                  @unique
  type                EmailNotificationType
  status              EmailNotificationStatus @default(PENDING)
  recipientEmail      String
  accessExpiresAt     DateTime?
  attemptCount        Int                     @default(0)
  deliveryGeneration  Int                     @default(0)
  lastAttemptAt       DateTime?
  lastError           String?
  providerId          String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  failedAt            DateTime?
  lastProviderEventAt DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deliveryAttempts    EmailDeliveryAttempt[]

  @@index([paymentId])
  @@index([providerId])
  @@index([status, createdAt])
}

model EmailDeliveryAttempt {
  id                  String                     @id @default(cuid())
  emailNotificationId String
  emailNotification   EmailNotification          @relation(fields: [emailNotificationId], references: [id], onDelete: Cascade)
  generation          Int
  providerId          String                     @unique
  status              EmailDeliveryAttemptStatus @default(SENT)
  sentAt              DateTime
  deliveredAt         DateTime?
  failedAt            DateTime?
  lastError           String?
  lastProviderEventAt DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@unique([emailNotificationId, generation])
  @@index([emailNotificationId])
}

model ResendWebhookEvent {
  id               String   @id
  type             String
  providerEmailId  String?
  occurredAt       DateTime
  rawPayload       Json?
  payloadExpiresAt DateTime
  createdAt        DateTime @default(now())

  @@index([payloadExpiresAt])
  @@index([providerEmailId])
}

model OrderLine {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName     String
  productSku      String
  quantity        Int
  listPriceCents  Int
  discountPercent Int?
  unitPriceCents  Int
  unitCostCents   Int
  lineTotalCents  Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  review          Review?
  reviewInvite    ReviewInvite?

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                      String              @id @default(cuid())
  orderId                 String
  order                   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type                    PaymentType
  status                  PaymentStatus       @default(PENDING)
  provider                PaymentProvider
  paymentMethod           PaymentMethod
  amountCents             Int
  currencyCode            String              @default("CHF")
  providerReference       String?
  stripeCheckoutSessionId String?
  failureReason           String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  emailNotifications      EmailNotification[]

  @@index([orderId])
  @@index([provider, providerReference])
  @@index([stripeCheckoutSessionId])
  @@index([status])
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderLineId String       @unique
  orderLine   OrderLine    @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int
  title       String?
  body        String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([productId, status])
  @@index([customerId])
}

model ReviewInvite {
  id          String    @id @default(cuid())
  orderLineId String    @unique
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  email       String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
